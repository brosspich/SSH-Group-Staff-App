{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./app/frontend/src/*"],
      "@/features/*": ["./app/frontend/src/features/*"],
      "@/shared/*": ["./app/frontend/src/shared/*"],
      "@/shared": ["./app/frontend/src/shared/index.ts"],
      "@/assets/*": ["./app/frontend/src/assets/*", "./app/frontend/assets/*"]
    }
  },
  "include": [
    "app/frontend/src/**/*.ts",
    "app/frontend/src/**/*.tsx",
    "app/frontend/expo-env.d.ts",
    "app/frontend/.expo/types/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/android",
    "**/ios"
  ]
}
