{
  "expo": {
    "name": "SSH Group Staff",
    "slug": "ssh-group-staff-app",
    // 1.0.0 = app version, 00 = num of edited, 0000 = dd/mm
    "version": "1.0.0.51808",
    "orientation": "portrait",
    "icon": "./src/assets/imgs/staff_logo_new_01_FG.png",
    "scheme": "sshgroupstaffapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1",
      "icon": "./src/assets/imgs/staff_logo_new_01_FG.png",
      "bundleIdentifier": "com.sshgroups.staffapp",
      "infoPlist": {
        "CFBundleDisplayName": "SSH Group Staff",
        "NSMicrophoneUsageDescription": "This app uses the microphone for audio input.",
        "NSDocumentsFolderUsageDescription": "This app needs access to your files for saving and sharing documents.",
        "NSDownloadsFolderUsageDescription": "This app needs access to your downloads folder.",
        "UIDeviceFamily": [1, 2],
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "appleTeamId": "QUX2SPNDSB",
      "supportsTablet": true
    },
    "android": {
      "targetSdkVersion": 36,
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "com.sshgroups.staffapp",
      "screenOrientation": "unspecified",
      "intentFilters": [],
      "config": {
        "maxAspectRatio": 2.4
      },
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/imgs/staff_logo_new_01_FG.png"
    },
    "splash": {
      "image": "./src/assets/imgs/staff_logo_new_01_FG.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F4F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F6",
          "image": "./src/assets/imgs/staff_logo_new_01_FG.png",
          "imageWidth": 120

          // "android": {
          //   "image": "./src/assets/imgs/staff_logo_new_01_FG.png",
          //   "imageWidth": 80
          // }
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SSH Group Staff App to access your camera to scan attendance QR codes."
        }
      ],
      "./src/plugins/withTabletOrientation",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
