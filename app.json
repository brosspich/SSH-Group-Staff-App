{
  "expo": {
    "name": "SSH Group Staff",
    "slug": "SSH-Group-Staff-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/imgs/staff_logo_app_v_001_pink.png",
    "scheme": "sshgroupstaffapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/imgs/staff_logo_app_v_001_pink.png",
      "bundleIdentifier": "com.sshgroups.staffapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/imgs/staff_logo_app_v_001_pink.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sshgroups.staffapp"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/imgs/staff_logo_app_v_001_pink.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/imgs/staff_logo_app_v_001_pink.png",
          "imageWidth": 80
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SSH Group Staff App to access your camera to scan attendance QR codes."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
