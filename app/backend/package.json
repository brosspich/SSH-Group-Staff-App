{
  "name": "ssh-group-backend",
  "version": "1.0.0",
  "description": "Production-grade, feature-based API backend adhering to SOLID and Clean Architecture",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "backend": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "sync:sub": "node scripts/sync_subscription_to_d1.js",
    "sync:sub:pull": "node scripts/sync_d1_subscription_to_local.js",
    "sync:user": "node scripts/sync_user_to_d1.js",
    "sync:user:pull": "node scripts/sync_user_to_local.js",
    "sync:company": "node scripts/sync_company_to_d1.js",
    "sync:company:pull": "node scripts/sync_company_to_local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
