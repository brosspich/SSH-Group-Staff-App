NODE_ENV=production
PORT=4000
DATABASE_URL="file:./dev.db" # Or your Cloudflare D1 / PostgreSQL connection string
JWT_SECRET="your-secure-jwt-secret-here"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Cloudflare R2 Storage (Optional for file & SSH key archives)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ssh-group-assets"
