datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               String          @id // system-0001, system-0002, system-0003
  name             String
  qrCodes          String?
  location         String?         // JSON array of google maps links
  telegramBotToken String?
  telegramChatId   String?
  timeIn           String?
  timeOut          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userDetails      UserDetails[]
  attendanceLogs   AttendanceLog[]
}

model User {
  systemId            String              @id @map("system_id")
  id                  String              // Staff ID e.g. "0001", "0022"
  username            String
  passwordHash        String
  role                String              @default("staff")
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  details             UserDetails?
  memberships         GroupMember[]
  serverKeys          ServerKey[]
  attendanceLogs      AttendanceLog[]
  attendanceRequests  AttendanceRequest[]
  deviceSessions      DeviceSession[]

  @@index([username])
}

model UserDetails {
  systemId    String    @id @map("system_id")
  companyId   String?   @map("company_id")
  name        String?
  email       String?
  phone       String?
  position    String?
  dob         String?
  joined      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [systemId], references: [systemId], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id])
}

model AttendanceLog {
  id         String   @id
  userId     String
  companyId  String?
  scanDate   String
  scanTime   String
  type       String   // 'TIME_IN', 'TIME_OUT', 'TIME_OTHER'
  qrData     String?
  image      String?
  remark     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [systemId], onDelete: Cascade)
  company    Company? @relation(fields: [companyId], references: [id])
}

model AttendanceRequest {
  id        String   @id
  userId    String
  subject   String
  remark    String?
  status    String   @default("pending") // 'pending', 'approved', 'rejected'
  fromDate  String?
  fromTime  String?
  toDate    String?
  toTime    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [systemId], onDelete: Cascade)
}

model DeviceSession {
  id           String   @id
  userId       String
  deviceName   String?
  modelName    String?
  modelNumber  String?
  os           String?
  osVersion    String?
  appVersion   String?
  ipAddress    String?
  location     String?
  isTerminated Int      @default(0)
  loginTimed   DateTime @default(now())
  lastActive   DateTime @default(now())
  lastLogin    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [systemId], onDelete: Cascade)
}

model ServerGroup {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  serverCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
}

model GroupMember {
  id         String      @id @default(uuid())
  userId     String
  groupId    String
  permission String      @default("read") // admin, write, read
  joinedAt   DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [systemId], onDelete: Cascade)
  group      ServerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model ServerKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  publicKey   String
  fingerprint String
  keyType     String    @default("ED25519")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [systemId], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  actorName String
  targetId  String?
  details   String?  // JSON stringified details
  ipAddress String?
  createdAt DateTime @default(now()) @map("timestamp")
}

model StaffUser {
  id                     String   @id
  name                   String?
  username               String?  @unique
  password               String?
  email                  String?
  phone                  String?
  position               String?
  role                   String?  // JSON array string e.g. ["staff", "admin"]
  devices                String?  // JSON array of device sessions
  joined                 String?
  attendance             String?  // JSON array of attendance records
  requestAttendanceRules String?  @map("request_attendance_rules")
  systemId               String?  @map("system_id")
  isActive               Boolean? @default(true) @map("is_active")

  @@map("ssh_group_staff_users")
}

model AttendanceQr {
  id               String  @id
  qrCode           String? @map("qr-code")
  companyName      String? @map("company_name")
  location         String? // JSON array of google maps links
  telegramBotToken String? @map("telegram_bot_token")
  telegramChatId   String? @map("telegram_chat_id")
  timeIn           String? @map("time-in")
  timeOut          String? @map("time-out")

  @@map("ssh-group-staff-attendance-qr")
}

model Subscription {
  id        String   @id
  systemId  String   @map("system_id")
  plan      String
  startDate String   @map("start_date")
  endDate   String   @map("end_date")
  createdAt DateTime @default(now())

  @@index([systemId])
}
