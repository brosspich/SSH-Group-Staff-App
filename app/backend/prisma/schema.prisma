datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               String      @id // system-0001, system-0002, system-0003
  name             String
  qrCodes          String?
  location         String?     // JSON array of google maps links
  telegramBotToken String?
  telegramChatId   String?
  timeIn           String?
  timeOut          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  users            User[]
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  email        String?
  passwordHash String
  name         String?
  role         String         @default("member")
  isActive     Boolean        @default(true)
  companyId    String?        @map("company_id")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company?       @relation(fields: [companyId], references: [id])
  memberships  GroupMember[]
  sshKeys      SshKey[]
}

model SshGroup {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  serverCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
}

model GroupMember {
  id         String    @id @default(uuid())
  userId     String
  groupId    String
  permission String    @default("read") // admin, write, read
  joinedAt   DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      SshGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model SshKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  publicKey   String
  fingerprint String
  keyType     String    @default("ED25519")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String
  actorName  String
  targetId   String?
  details    String?  // JSON stringified details
  ipAddress  String?
  createdAt  DateTime @default(now()) @map("timestamp")
}

model StaffUser {
  id                      String   @id
  name                    String?
  username                String?  @unique
  password                String?
  email                   String?
  phone                   String?
  position                String?
  role                    String?  // JSON array string e.g. ["staff", "admin"]
  devices                 String?  // JSON array of device sessions
  joined                  String?
  attendance              String?  // JSON array of attendance records
  requestAttendanceRules  String?  @map("request_attendance_rules")
  systemId                String?  @map("system_id")
  isActive                Boolean? @default(true) @map("is_active")

  @@map("ssh_group_staff_users")
}

model AttendanceQr {
  id               String  @id
  qrCode           String? @map("qr-code")
  companyName      String? @map("company_name")
  location         String? // JSON array of google maps links
  telegramBotToken String? @map("telegram_bot_token")
  telegramChatId   String? @map("telegram_chat_id")
  timeIn           String? @map("time-in")
  timeOut          String? @map("time-out")

  @@map("ssh-group-staff-attendance-qr")
}
