{
  "expo": {
    "name": "SSH Group Staff",
    "slug": "ssh-group-staff-app",
    // 1.0.1 = app version (Apple allows max 3 numbers: major.minor.patch)
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/imgs/staff_logo_new_01_FG.png",
    "scheme": "sshgroupstaffapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "10311",
      "icon": "./src/assets/imgs/staff_logo_new_01_FG.png",
      "bundleIdentifier": "com.sshgroups.staffapp",
      "infoPlist": {
        "CFBundleDisplayName": "SSH Group Staff",
        "NSCameraUsageDescription": "Allow SSH Group Staff App to access your camera to scan attendance QR codes and capture proof photos.",
        "NSLocationWhenInUseUsageDescription": "Allow SSH Group Staff App to access your location to verify attendance within company workplace geofences during check-in.",
        "NSPhotoLibraryUsageDescription": "Allow SSH Group Staff App to access your photos to attach proof photos for attendance requests and update profile avatars.",
        "NSDocumentsFolderUsageDescription": "This app needs access to your files for saving and sharing documents.",
        "NSDownloadsFolderUsageDescription": "This app needs access to your downloads folder.",
        "UIDeviceFamily": [1, 2],
        "UIRequiresFullScreen": true,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        },
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "appleTeamId": "QUX2SPNDSB",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 10311,
      "predictiveBackGestureEnabled": false,
      "package": "com.sshgroups.staffapp",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/imgs/staff_logo_new_01_FG.png",
        "backgroundColor": "#F3F4F6"
      },
      "intentFilters": [],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/imgs/staff_logo_new_01_FG.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "style": "dark-content"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F6",
          "image": "./src/assets/imgs/staff_logo_new_01_FG.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SSH Group Staff App to access your camera to scan attendance QR codes and capture proof photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SSH Group Staff App to access your location to verify attendance within company workplace geofences during check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SSH Group Staff App to access your photos to attach proof photos for attendance requests and update profile avatars."
        }
      ],
      "./src/shared/plugins/withTabletOrientation"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
